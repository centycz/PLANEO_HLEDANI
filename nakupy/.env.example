# Zkopiruj jako .env a vypln vlastni hodnoty
# Tajny klic pro podepisovani session cookie (vygeneruj: openssl rand -hex 32)
NAKUPY_SECRET_KEY=zmen-me-na-nahodny-retezec
# Kam se uklada databaze a nahrane PDF (v Dockeru je to namountovany volume)
NAKUPY_DATA_DIR=/data
# Prvni admin ucet - vytvori se pri prvnim startu, pak se da zmenit v Nastaveni
NAKUPY_ADMIN_USER=admin
NAKUPY_ADMIN_PASSWORD=zmen-me
NAKUPY_ADMIN_NAME=Admin
# true = cookie jen pres HTTPS (na produkci za nginx s certifikatem nech true)
NAKUPY_SECURE_COOKIES=true
# Casova zona pro zobrazeni datumu
NAKUPY_TZ=Europe/Prague
# Port, na kterem posloucha uvicorn uvnitr kontejneru
NAKUPY_PORT=8000
